# Node/Express application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Server-only Supabase credentials. Never use a service-role key in a VITE_* variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Browser-safe Supabase Auth client. These values are safe to expose publicly.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_API_URL=/api

# Optional: privacy-conscious page-view measurement; unset to disable analytics.
VITE_GA_MEASUREMENT_ID=
LOG_LEVEL=info
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
